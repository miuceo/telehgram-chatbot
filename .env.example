# ==========================================
# TELEGRAM BOT SOZLAMALARI VA MAXFIY KALITLAR
# ==========================================

TELEGRAM_BOT_TOKEN=SIZNING_TELEGRAM_BOT_TOKENINGIZ
GEMINI_API_KEY=SIZNING_GEMINI_API_KALITINGIZ

# ==========================================
# SUN'IY INTELLEKT MODELLARI (100% BEPUL)
# ==========================================
# 1. Agent miyasi (funksiyalar va marshrutlash):
BRAIN_MODEL=gemma-4-26b-a4b-it
BRAIN_FALLBACK_MODEL=gemini-3.5-flash-lite

# 2. Rasmlarni tushunish va tahlil qilish:
VISION_MODEL=gemma-4-31b-it
VISION_FALLBACK_MODEL=gemini-3.5-flash-lite

# 3. Matnlar: suhbat, xulosa, tarjima, test tuzish:
WRITER_MODEL=gemma-4-31b-it
WRITER_FALLBACK_MODEL=gemma-4-26b-a4b-it

# 4. Qisqa audio (<= 55 daqiqa) transkripsiyasi:
TRANSCRIBE_MODEL=gemini-3.5-transcribe
TRANSCRIBE_FALLBACK_MODEL=gemini-3.1-flash-lite

# 5. Uzun audio (> 55 daqiqa) yoki transkripsiya bo'sh bo'lganda:
LONG_AUDIO_MODEL=gemini-3.1-flash-lite
LONG_AUDIO_FALLBACK_MODEL=gemini-3.5-flash-lite

# Foydalanuvchi suhbat xotirasi (oxirgi nechta xabarni eslab qolsin):
MAX_HISTORY_MESSAGES=10
